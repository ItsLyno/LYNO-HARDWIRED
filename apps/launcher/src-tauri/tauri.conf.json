{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LYNO HARDWIRED",
  "version": "0.6.0",
  "identifier": "dev.lyno.hardwired",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LYNO//HARDWIRED",
        "width": 1280,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDOUU5OEM1NUZENUUyRjMKUldUejR0VmZ4WmllZkJiU3ZrRTl3bHlJc0JPL0NJazRIcXhZR25RL3ZSZlV1S1BOdHZkOWZRTmoK",
      "endpoints": ["https://raw.githubusercontent.com/ItsLyno/LYNO-HARDWIRED/main/launcher/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
